# Copy to .env (same folder) and fill in. Never commit .env.
# Optional: enables LLM triage notes, locator self-healing and requirement gap-mapping.
# Without it the agent still runs every check; verdicts never depend on the LLM.
ANTHROPIC_API_KEY=
